# Port the API listens on
PORT=4000

# Postgres connection string: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:your-password@localhost:5432/postly

# Origin of the React dev server, allowed through CORS
CLIENT_ORIGIN=http://localhost:5173

# Signs the login cookie. Any long random string; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Cloudinary, for signing photo uploads (Cloudinary console > Settings > API Keys).
# The secret stays on the server; never put it in client/.env.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
